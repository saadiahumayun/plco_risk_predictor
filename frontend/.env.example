# Frontend Environment Variables
# Copy this file to .env.local for local development or set in Vercel dashboard for production

# API URL - Backend endpoint
# For local development with backend running on port 8000, leave empty or comment out (uses proxy)
# For production, set to your Railway backend URL
VITE_API_URL=https://plcoriskpredictor-production.up.railway.app/api/v1
